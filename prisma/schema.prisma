// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("quran_education_DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  INSTITUTE_OWNER
  BRANCH_MANAGER
  TEACHER
  STAFF
  PARENT
  STUDENT
}

enum ProgressStartType {
  NEW
  CONTINUING
}

enum HifzDirection {
  FORWARD  // Para 1 → 30 (start with Surah Al-Baqarah)
  REVERSE  // Para 30 → 1 (start with Juz Amma — common in Pakistan)
}

enum StudentDocumentCategory {
  PARENT_CNIC_FRONT
  PARENT_CNIC_BACK
  MOTHER_CNIC_FRONT
  MOTHER_CNIC_BACK
  GUARDIAN_CNIC_FRONT
  GUARDIAN_CNIC_BACK
  STUDENT_BFORM
  STUDENT_CNIC
  STUDENT_PASSPORT
  PREVIOUS_CERTIFICATE
  TRANSFER_LETTER
  MEDICAL_REPORT
  VACCINATION_RECORD
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ProgramType {
  HIFZ
  NAZRA
  TAJWEED
  COMBINED
}

enum AlumniCompletionType {
  HIFZ_FULL
  NAZRA_COMPLETE
  TAJWEED_CERTIFIED
  OTHER
}

enum HifzType {
  SABAQ
  SABQI
  MANZIL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HOLIDAY
}

enum AttendanceMethod {
  MANUAL
  QR_CODE
  RFID
  FINGERPRINT
}

enum AssessmentType {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
  PARTIAL
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  IBFT
  RAAST
  STRIPE
  JAZZCASH
  EASYPAISA
  SCHOLARSHIP
  CHEQUE
  OTHER
}

enum SponsorType {
  INDIVIDUAL
  ORGANIZATION
  CORPORATE
  ANONYMOUS
}

enum DonationFrequency {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum DonationCategory {
  GENERAL
  SCHOLARSHIP
  BUILDING
  OPERATIONS
  RAMADAN
  ZAKAT
  SADAQAH
  OTHER
}

enum DonationStatus {
  RECEIVED
  PLEDGED
  PARTIAL
  CANCELLED
}

enum AdmissionStatus {
  APPLIED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  APPROVED
  ENROLLED
  REJECTED
  WITHDRAWN
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  ENTERPRISE
}

enum AuditAudience {
  INSTITUTE_OWNER
  SUPER_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

enum NotificationType {
  ABSENCE
  LOW_PERFORMANCE
  FEE_DUE
  ACHIEVEMENT
  ANNOUNCEMENT
  MESSAGE
  EXAM_RESULT
  GENERAL
  LEAVE_REQUEST
  FEE_CLAIM
  REVISION_DUE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ComplaintStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  CLOSED
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ─────────────────────────────────────────────
// SUBSCRIPTION & PLATFORM
// ─────────────────────────────────────────────

model SubscriptionPlanConfig {
  id              String           @id @default(cuid())
  plan            SubscriptionPlan @unique
  name            String
  description     String?
  monthlyPrice    Decimal          @db.Decimal(10, 2)
  annualPrice     Decimal          @db.Decimal(10, 2)
  maxStudents     Int?             // null = unlimited
  maxBranches     Int?
  maxTeachers     Int?
  features        Json             // Array of feature flags
  stripePriceId   String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  institutes      InstituteSubscription[]
}

// ─────────────────────────────────────────────
// INSTITUTE
// ─────────────────────────────────────────────

model Institute {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  logo              String?
  coverImage        String?
  description       String?
  email             String
  phone             String?
  website           String?
  address           String?
  city              String?
  country           String    @default("PK")
  postalCode        String?
  registrationNo    String?
  directorName      String?
  directorEmail     String?
  directorPhone     String?
  tagline           String?
  vision            String?   @db.Text
  mission           String?   @db.Text
  goals             Json?     // [{ title, description }]
  values            Json?     // [{ title, description }]
  achievements      Json?     // [{ year, title, description }]
  foundedYear       Int?
  isActive          Boolean   @default(true)
  isApproved        Boolean   @default(false)
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  subscription      InstituteSubscription?
  branches          Branch[]
  users             User[]
  students          Student[]
  teachers          Teacher[]
  classes           Class[]
  feeStructures     FeeStructure[]
  announcements     Announcement[]
  supportTickets    SupportTicket[]
  complaints        Complaint[]
  badges            Badge[]
  assessments       Assessment[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  characterTasks    CharacterTask[]
  dailyDuas         DailyDua[]
  salaryPayments    SalaryPayment[]
  profileChangeRequests ProfileChangeRequest[]
  calendarEvents    CalendarEvent[]
  holidays          InstituteHoliday[]
  sponsors          Sponsor[]
  donations         Donation[]
  donationSpends    DonationSpend[]
  managementMembers InstituteManagementMember[]
  alumni            InstituteAlumni[]

  @@index([slug])
  @@index([isApproved])
}

model InstituteManagementMember {
  id             String   @id @default(cuid())
  fullName       String
  email          String?
  phone          String?
  roleTitle      String
  department     String?
  qualifications String?  @db.Text
  bio            String?  @db.Text
  photo          String?
  joinDate       DateTime? @db.Date
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  instituteId    String
  institute      Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  reportsToId    String?
  reportsTo      InstituteManagementMember?  @relation("ManagementReporting", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports  InstituteManagementMember[] @relation("ManagementReporting")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([instituteId])
  @@index([reportsToId])
  @@index([instituteId, isActive])
}

model InstituteAlumni {
  id             String               @id @default(cuid())
  fullName       String
  photo          String?
  gender         Gender?
  programType    ProgramType          @default(HIFZ)
  completionType AlumniCompletionType @default(HIFZ_FULL)
  completedAt    DateTime             @db.Date
  batchYear      String?
  studentIdLabel String?
  teacherName    String?
  totalDaysHifz  Int?
  occupation     String?
  currentStudy   String?
  city           String?
  achievements   String?              @db.Text
  testimonial    String?              @db.Text
  isFeatured     Boolean              @default(false)
  isPublic       Boolean              @default(true)
  studentId      String?              @unique
  student        Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  instituteId    String
  institute      Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([instituteId])
  @@index([instituteId, completedAt])
  @@index([instituteId, isFeatured])
  @@index([instituteId, isPublic])
}

model InstituteSubscription {
  id              String             @id @default(cuid())
  instituteId     String             @unique
  institute       Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan
  status          SubscriptionStatus @default(TRIALING)
  planConfig      SubscriptionPlanConfig @relation(fields: [plan], references: [plan])
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEndsAt     DateTime?
  canceledAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Branch {
  id          String    @id @default(cuid())
  name        String
  code        String?
  address     String?
  city        String?
  phone       String?
  email       String?
  isActive    Boolean   @default(true)
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  students    Student[]
  teachers    Teacher[]
  classes     Class[]
  managers    User[]

  @@index([instituteId])
}

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  role            Role
  isActive        Boolean   @default(true)
  mustChangePassword Boolean @default(false)
  staffRole       String?   // e.g. "Accountant", "Receptionist", "Cleaner"
  phone           String?
  salary          Decimal?  @db.Decimal(10, 2)
  bankName        String?
  accountTitle    String?
  accountNumber   String?
  iban            String?
  instituteId     String?
  institute       Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  accounts        Account[]
  sessions        Session[]
  teacher         Teacher?
  parent          Parent?
  student         Student?
  sentMessages    Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  notifications   Notification[]
  auditLogs       AuditLog[]

  staffSalaryPayments SalaryPayment[] @relation("StaffSalaryPayments")
  profileChangeRequests ProfileChangeRequest[] @relation("ProfileChangeRequests")
  profileChangeReviews  ProfileChangeRequest[] @relation("ProfileChangeReviews")
  uploadedStudentDocuments StudentDocument[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([instituteId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ─────────────────────────────────────────────
// TEACHER
// ─────────────────────────────────────────────

model Teacher {
  id              String    @id @default(cuid())
  teacherCode     String    @unique
  qualification   String?
  specialization  String?   // Hifz, Nazra, Tajweed, Arabic
  experience      Int?      // years
  joinDate        DateTime
  salary          Decimal?  @db.Decimal(10, 2)
  bankName        String?
  accountTitle    String?
  accountNumber   String?
  iban            String?
  isActive        Boolean   @default(true)
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  instituteId     String
  institute       Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  classes         Class[]
  salaryPayments  SalaryPayment[] @relation("TeacherSalaryPayments")
  students        Student[]
  hifzRecords     HifzRecord[]
  hifzParaCompletions HifzParaCompletion[]
  nazraRecords    NazraRecord[]
  attendanceRecords Attendance[]
  teacherAttendance TeacherAttendance[]
  assessments     Assessment[]
  feedbacks       TeacherFeedback[]
  characterTaskProgress CharacterTaskProgress[]
  characterTaskAssignments CharacterTaskAssignment[]
  characterTaskClassProgress CharacterTaskClassProgress[]
  dailyDuaAssignments DailyDuaAssignment[]
  dailyDuaClassProgress DailyDuaClassProgress[]

  @@index([instituteId])
  @@index([branchId])
}

model TeacherAttendance {
  id          String           @id @default(cuid())
  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  status      AttendanceStatus
  workingHours Decimal?        @db.Decimal(4, 2)
  notes       String?
  teacherId   String
  teacher     Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@unique([teacherId, date])
  @@index([teacherId])
  @@index([date])
}

// ─────────────────────────────────────────────
// PARENT
// ─────────────────────────────────────────────

model Parent {
  id          String    @id @default(cuid())
  relation    String    @default("Parent") // Father, Mother, Guardian
  occupation  String?
  cnic        String?
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  students    Student[]
  guardianships StudentGuardian[]

  @@index([userId])
}

// ─────────────────────────────────────────────
// STUDENT
// ─────────────────────────────────────────────

model Student {
  id              String          @id @default(cuid())
  studentId       String          @unique  // auto-generated e.g. STU-2024-001
  fullName        String
  photo           String?
  gender          Gender
  dateOfBirth     DateTime        @db.Date
  bloodGroup      String?
  medicalNotes    String?
  address         String?
  city            String?
  country         String?       @default("PK")
  emergencyContact String?
  emergencyPhone  String?
  previousEducation String?
  progressStartType ProgressStartType @default(NEW)
  previousInstitute String?
  hifzDirection   HifzDirection?  // HIFZ program: memorization order
  admissionDate   DateTime        @db.Date
  admissionStatus AdmissionStatus @default(ENROLLED)
  programType     ProgramType
  currentPara     Int?            // 1-30
  currentJuz      Int?            // 1-30
  currentSurah    Int?            // 1-114
  currentPage     Int?
  targetCompletionDate DateTime?  @db.Date
  hifzCompletedAt   DateTime?
  isActive        Boolean         @default(true)
  /// Opaque token for QR check-in (rotated on regenerate)
  qrToken         String?         @unique
  qrTokenCreatedAt DateTime?
  instituteId     String
  institute       Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  teacherId       String?
  teacher         Teacher?        @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  parentId        String?
  parent          Parent?         @relation(fields: [parentId], references: [id], onDelete: SetNull)
  userId          String?         @unique
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  enrollments     ClassEnrollment[]
  hifzRecords     HifzRecord[]
  hifzParaCompletions HifzParaCompletion[]
  nazraRecords    NazraRecord[]
  tajweedRecords  TajweedRecord[]
  attendance      Attendance[]
  leaveRequests   LeaveRequest[]
  assessmentResults AssessmentResult[]
  feePayments     FeePayment[]
  scholarships    Scholarship[]
  sponsorLinks    StudentSponsor[]
  badges          StudentBadge[]
  qualityScores   HifzQualityScore[]
  admissionApplications AdmissionApplication[]
  characterTaskProgress CharacterTaskProgress[]
  dailyWorshipRecords   DailyWorshipRecord[]
  documents             StudentDocument[]
  alumni                InstituteAlumni?
  guardians             StudentGuardian[]

  @@index([instituteId])
  @@index([branchId])
  @@index([teacherId])
  @@index([studentId])
  @@index([parentId])
  @@index([instituteId, isActive])
  @@index([instituteId, createdAt])
  @@index([instituteId, programType])
  @@index([branchId, isActive])
  @@index([teacherId, createdAt])
}

model StudentGuardian {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId   String
  parent     Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  relation   String   @default("Guardian") // Father, Mother, Guardian
  isPrimary  Boolean  @default(false)
  canPickup  Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, parentId])
  @@index([parentId])
  @@index([studentId])
}

// ─────────────────────────────────────────────
// STUDENT DOCUMENTS
// ─────────────────────────────────────────────

model StudentDocument {
  id           String                  @id @default(cuid())
  studentId    String
  student      Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category     StudentDocumentCategory
  label        String?
  fileName     String
  mimeType     String
  fileSize     Int
  fileData     String                  @db.Text
  uploadedById String?
  uploadedBy   User?                   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([studentId])
  @@index([category])
}

model AdmissionApplication {
  id              String          @id @default(cuid())
  applicationNo   String          @unique
  studentId       String?
  student         Student?        @relation(fields: [studentId], references: [id])
  applicantName   String
  gender          Gender
  dateOfBirth     DateTime        @db.Date
  parentName      String
  parentPhone     String
  parentEmail     String?
  address         String?
  city            String?
  country         String?       @default("PK")
  programType     ProgramType
  previousEducation String?
  status          AdmissionStatus @default(APPLIED)
  interviewDate   DateTime?
  interviewNotes  String?
  reviewedBy      String?
  approvedBy      String?
  rejectionReason String?
  instituteId     String
  branchId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([instituteId])
  @@index([status])
}

// ─────────────────────────────────────────────
// CLASS
// ─────────────────────────────────────────────

model Class {
  id          String    @id @default(cuid())
  name        String
  code        String?
  programType ProgramType
  capacity    Int       @default(30)
  schedule        Json?     // e.g. [{day: "MONDAY", startTime: "08:00", endTime: "10:00"}]
  meetingLink     String?   // For live classes (Zoom, Meet, etc.)
  meetingPlatform String?   // "Zoom", "Google Meet", etc.
  meetingPassword String?
  isActive        Boolean   @default(true)
  teacherId       String?
  teacher         Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  instituteId     String
  institute       Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  enrollments ClassEnrollment[]
  attendance  Attendance[]
  assessments Assessment[]
  characterTaskClassProgress CharacterTaskClassProgress[]
  dailyDuaClassProgress DailyDuaClassProgress[]

  @@index([instituteId])
  @@index([branchId])
}

model ClassEnrollment {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId     String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime  @default(now())
  isActive    Boolean   @default(true)

  @@unique([studentId, classId])
  @@index([classId])
  @@index([studentId])
  @@index([studentId, isActive])
}

// ─────────────────────────────────────────────
// QURAN LEARNING
// ─────────────────────────────────────────────

model HifzRecord {
  id            String    @id @default(cuid())
  date          DateTime  @db.Date
  type          HifzType
  surahNumber   Int       // 1-114
  surahName     String?
  ayahFrom      Int
  ayahTo        Int
  lines         Int?
  pages         Int?
  juzNumber     Int?
  rating        Int       // 1-5 stars
  errorCount    Int       @default(0)
  fluencyScore  Decimal?  @db.Decimal(4, 2) // 0.00 - 10.00
  retentionScore Decimal? @db.Decimal(4, 2)
  isRevision    Boolean   @default(false)
  teacherNote   String?
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId     String?
  teacher       Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([studentId])
  @@index([date])
  @@index([type])
  @@index([studentId, date])
}

model HifzParaCompletion {
  id             String   @id @default(cuid())
  paraNumber     Int      // 1-30
  completedAt    DateTime @db.Date
  daysToComplete Int
  notes          String?
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedById     String?
  markedBy       Teacher? @relation(fields: [markedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, paraNumber])
  @@index([studentId])
}

model NazraRecord {
  id              String    @id @default(cuid())
  date            DateTime  @db.Date
  surahNumber     Int
  surahName       String?
  pageFrom        Int
  pageTo          Int
  readingAccuracy Decimal   @db.Decimal(5, 2) // percentage
  tajweedAccuracy Decimal   @db.Decimal(5, 2)
  fluency         Int       // 1-5
  completionPct   Decimal?  @db.Decimal(5, 2) // overall % of Quran
  teacherNote     String?
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId       String?
  teacher         Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  @@index([studentId])
  @@index([date])
}

model TajweedRule {
  id          String    @id @default(cuid())
  category    String    // e.g. "Makharij", "Noon Sakinah", "Madd"
  ruleName    String
  arabicName  String?
  description String?
  order       Int
  records     TajweedRecord[]
  createdAt   DateTime  @default(now())
}

model TajweedRecord {
  id            String      @id @default(cuid())
  isMastered    Boolean     @default(false)
  masteredAt    DateTime?
  practiceScore Int?        // 1-10
  notes         String?
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ruleId        String
  rule          TajweedRule @relation(fields: [ruleId], references: [id])
  assessedBy    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([studentId, ruleId])
  @@index([studentId])
}

model HifzQualityScore {
  id              String    @id @default(cuid())
  period          String    // "2024-W01" (weekly) or "2024-01" (monthly)
  periodType      String    // "WEEKLY" | "MONTHLY"
  accuracyScore   Decimal   @db.Decimal(5, 2)
  fluencyScore    Decimal   @db.Decimal(5, 2)
  retentionScore  Decimal   @db.Decimal(5, 2)
  consistencyScore Decimal  @db.Decimal(5, 2)
  attendanceScore Decimal   @db.Decimal(5, 2)
  overallScore    Decimal   @db.Decimal(5, 2)
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@unique([studentId, period, periodType])
  @@index([studentId])
}

// ─────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────

model Attendance {
  id               String           @id @default(cuid())
  date             DateTime         @db.Date
  status           AttendanceStatus
  method           AttendanceMethod @default(MANUAL)
  checkInTime      DateTime?
  leaveReason      String?
  leaveRequestedBy String?
  notes            String?
  studentId        String
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId          String?
  class            Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  markedById       String?
  markedBy         Teacher?         @relation(fields: [markedById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([studentId, date, classId])
  @@index([studentId])
  @@index([date])
  @@index([classId])
  @@index([studentId, date])
}

model LeaveRequest {
  id             String             @id @default(cuid())
  studentId      String
  student        Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instituteId    String
  requestedById  String
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  reason         String             @db.Text
  status         LeaveRequestStatus @default(PENDING)
  reviewedById   String?
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([instituteId, status])
  @@index([studentId])
  @@index([requestedById])
  @@index([startDate, endDate])
}

// ─────────────────────────────────────────────
// ASSESSMENT
// ─────────────────────────────────────────────

model Assessment {
  id              String         @id @default(cuid())
  title           String
  type            AssessmentType
  programType     ProgramType
  startDate       DateTime       @db.Date
  endDate         DateTime?      @db.Date
  description     String?
  maxScore        Decimal        @db.Decimal(6, 2) @default(100)
  passingScore    Decimal        @db.Decimal(6, 2) @default(50)
  isActive        Boolean        @default(true)
  instituteId     String
  institute       Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classId         String?
  class           Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacherId       String?
  teacher         Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  results         AssessmentResult[]

  @@index([instituteId])
  @@index([classId])
  @@index([instituteId, startDate])
}

model AssessmentResult {
  id              String     @id @default(cuid())
  juzTested       Int?
  surahFrom       Int?
  surahTo         Int?
  mistakeCount    Int        @default(0)
  score           Decimal    @db.Decimal(6, 2)
  grade           String?    // A, B, C, D, F
  readingAccuracy Decimal?   @db.Decimal(5, 2)
  tajweedScore    Decimal?   @db.Decimal(5, 2)
  fluencyScore    Decimal?   @db.Decimal(5, 2)
  remarks         String?
  isPassed        Boolean    @default(false)
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([assessmentId])
}

// ─────────────────────────────────────────────
// FEE & FINANCE
// ─────────────────────────────────────────────

model FeeStructure {
  id              String      @id @default(cuid())
  name            String
  programType     ProgramType?
  amount          Decimal     @db.Decimal(10, 2)
  currency        String      @default("PKR")
  frequency       String      @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUAL, ONE_TIME
  isActive        Boolean     @default(true)
  description     String?
  instituteId     String
  institute       Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([instituteId])
}

model FeePayment {
  id              String        @id @default(cuid())
  invoiceNo       String        @unique
  amount          Decimal       @db.Decimal(10, 2)
  discount        Decimal       @db.Decimal(10, 2) @default(0)
  netAmount       Decimal       @db.Decimal(10, 2)
  currency        String        @default("PKR")
  status          PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod?
  dueDate         DateTime      @db.Date
  paidAt          DateTime?
  month           String?       // "2024-01" for monthly tracking
  receiptUrl      String?
  stripePaymentId String?
  notes           String?
  /// Parent submitted "I paid" claim awaiting staff verify
  claimStatus     String?         // CLAIMED | VERIFIED | REJECTED
  claimedAt       DateTime?
  claimMethod     PaymentMethod?
  claimReference  String?
  claimNote       String?
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// When fee is paid from a sponsor's fund
  sponsorId       String?
  sponsor         Sponsor?      @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@index([studentId, month])
  @@index([claimStatus])
  @@index([sponsorId])
}

model Scholarship {
  id              String    @id @default(cuid())
  name            String
  amount          Decimal   @db.Decimal(10, 2)
  percentage      Decimal?  @db.Decimal(5, 2)
  isFullScholarship Boolean @default(false)
  donorName       String?
  donorEmail      String?
  donorPhone      String?
  reason          String?
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  isActive        Boolean   @default(true)
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([studentId])
}

// ─────────────────────────────────────────────
// SPONSORS & DONATIONS
// ─────────────────────────────────────────────

model Sponsor {
  id           String      @id @default(cuid())
  name         String
  type         SponsorType @default(INDIVIDUAL)
  email        String?
  phone        String?
  organization String?
  profession   String?
  employer     String?
  city         String?
  cnic         String?
  photo        String?
  address      String?
  notes        String?
  isActive     Boolean     @default(true)
  instituteId  String
  institute    Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  donations    Donation[]
  sponsoredStudents StudentSponsor[]
  feePayments  FeePayment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([instituteId])
  @@index([isActive])
}

/// Links a student to one or more fee sponsors
model StudentSponsor {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sponsorId String
  sponsor   Sponsor   @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  isActive  Boolean   @default(true)
  notes     String?
  startDate DateTime  @default(now()) @db.Date
  endDate   DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([studentId, sponsorId])
  @@index([sponsorId])
  @@index([studentId])
  @@index([isActive])
}

model Donation {
  id             String            @id @default(cuid())
  amount         Decimal           @db.Decimal(12, 2)
  currency       String            @default("PKR")
  donationDate   DateTime          @db.Date
  frequency      DonationFrequency @default(ONE_TIME)
  category       DonationCategory  @default(GENERAL)
  status         DonationStatus    @default(RECEIVED)
  paymentMethod  PaymentMethod?
  referenceNo    String?
  purpose        String?
  notes          String?
  receiptData    String?           @db.Text
  receivedByName String?
  periodMonth    String?           // "2024-06" for monthly reporting
  sponsorId      String?
  sponsor        Sponsor?          @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  instituteId    String
  institute      Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  recordedById   String?
  spends         DonationSpend[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([instituteId])
  @@index([donationDate])
  @@index([periodMonth])
  @@index([sponsorId])
  @@index([status])
}

/// Outflow from a specific donation (reason + place + category)
model DonationSpend {
  id           String    @id @default(cuid())
  amount       Decimal   @db.Decimal(12, 2)
  reason       String
  place        String
  category     String    // spend category key, e.g. OPERATIONS
  spentAt      DateTime  @db.Date
  notes        String?
  donationId   String
  donation     Donation  @relation(fields: [donationId], references: [id], onDelete: Cascade)
  instituteId  String
  institute    Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  recordedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([donationId])
  @@index([instituteId])
  @@index([category])
  @@index([spentAt])
}

// ─────────────────────────────────────────────
// COMMUNICATION
// ─────────────────────────────────────────────

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  isPinned    Boolean   @default(false)
  targetRoles Role[]
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([instituteId])
}

model Message {
  id          String    @id @default(cuid())
  subject     String?
  content     String    @db.Text
  /// TEXT | STICKER | RICH — kept as String for flexible client payloads
  contentType String    @default("TEXT")
  stickerId   String?
  /// Map of emoji -> array of userIds who reacted, e.g. { "❤️": ["cuid1"] }
  reactions   Json?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  parentMessageId String?
  parentMessage   Message? @relation("MessageThread", fields: [parentMessageId], references: [id])
  replies     Message[] @relation("MessageThread")
  createdAt   DateTime  @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@index([receiverId, isRead])
  @@index([senderId, receiverId, createdAt])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  message     String
  data        Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instituteId String?
  institute   Institute?       @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────
// GAMIFICATION
// ─────────────────────────────────────────────

model Badge {
  id          String    @id @default(cuid())
  name        String
  nameArabic  String?
  description String?
  icon        String    // emoji or icon name
  color       String    @default("#D4AF37")
  criteria    Json      // trigger conditions
  isActive    Boolean   @default(true)
  instituteId String?
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  // Relations
  studentBadges StudentBadge[]
}

model StudentBadge {
  id          String    @id @default(cuid())
  earnedAt    DateTime  @default(now())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeId     String
  badge       Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeId])
  @@index([studentId])
}

// ─────────────────────────────────────────────
// TEACHER PERFORMANCE
// ─────────────────────────────────────────────

model TeacherFeedback {
  id          String    @id @default(cuid())
  rating      Int       // 1-5
  comment     String?
  period      String    // "2024-01"
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  givenById   String?   // parent user id
  createdAt   DateTime  @default(now())

  @@index([teacherId])
}

// ─────────────────────────────────────────────
// CHILD PROTECTION / SAFEGUARDING
// ─────────────────────────────────────────────

model Complaint {
  id              String            @id @default(cuid())
  caseNumber      String            @unique
  title           String
  description     String            @db.Text
  category        String            @default("GENERAL") // BULLYING, NEGLECT, ABUSE, SAFETY, BEHAVIOUR, GENERAL
  severity        ComplaintSeverity @default(MEDIUM)
  status          ComplaintStatus   @default(OPEN)
  involvedParties String?
  evidenceNotes   String?           @db.Text
  isConfidential  Boolean           @default(true)
  resolution      String?           @db.Text
  resolvedAt      DateTime?
  studentId       String?
  branchId        String?
  instituteId     String
  institute       Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  reportedById    String?
  assignedToId    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  auditLogs       ComplaintAuditLog[]

  @@index([instituteId])
  @@index([status])
  @@index([category])
  @@index([studentId])
}

model ComplaintAuditLog {
  id          String    @id @default(cuid())
  action      String
  details     String?   @db.Text
  performedBy String
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([complaintId])
}

// ─────────────────────────────────────────────
// AUDIT TRAIL
// ─────────────────────────────────────────────

model AuditLog {
  id              String        @id @default(cuid())
  entityType      String
  entityId        String
  entityLabel     String?
  action          String
  details         String?       @db.Text
  performedById   String
  performedBy     User          @relation(fields: [performedById], references: [id], onDelete: Cascade)
  performerRole   Role
  instituteId     String?
  institute       Institute?    @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  audience        AuditAudience
  createdAt       DateTime      @default(now())

  @@index([entityType, entityId])
  @@index([instituteId])
  @@index([audience])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// SUPPORT
// ─────────────────────────────────────────────

model SupportTicket {
  id          String    @id @default(cuid())
  ticketNo    String    @unique
  subject     String
  description String    @db.Text
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String    @default("MEDIUM")
  response    String?   @db.Text
  respondedAt DateTime?
  instituteId String?
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  submittedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([instituteId])
  @@index([status])
}

// ─────────────────────────────────────────────
// CHARACTER BUILDING
// ─────────────────────────────────────────────

model CharacterTask {
  id                        String   @id @default(cuid())
  title                     String
  description               String?
  islamicObjective          String?
  quranEvidence             String?
  hadithEvidence            String?
  teacherDeliveryNotes      String?
  practicalClassroomActivity String?
  dailyObservationChecklist String?
  homePractice              String?
  assessmentMethod          String?  // OBSERVED, PARENT_CONFIRMATION, STUDENT_REFLECTION
  duration                  String?  // ONE_WEEK, TWO_WEEKS, ONE_MONTH
  ageGroup                  String?
  repeatCycle               String?  // ONE_TIME, WEEKLY, MONTHLY, CONTINUOUS
  completionCriteria        String?
  category                  String   @default("AKHLAAQ") // AKHLAAQ, ADAB, RESPONSIBILITY, WORSHIP, SOCIAL
  priority                  String   @default("MEDIUM")  // CRITICAL, HIGH, MEDIUM, OPTIONAL (legacy: NORMAL/LOW)
  dueDate                   DateTime @db.Date
  isActive                  Boolean  @default(true)
  instituteId               String
  institute                 Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdAt                 DateTime @default(now())
