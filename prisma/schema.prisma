  status      String   @default("PENDING") // PENDING, TAUGHT, COMPLETED
  notes       String?
  taughtAt    DateTime?
  completedAt DateTime?
  taskId      String
  task        CharacterTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([taskId, classId])
  @@index([taskId])
  @@index([classId])
  @@index([teacherId])
}

model CharacterTaskAssignment {
  id         String   @id @default(cuid())
  taskId     String
  task       CharacterTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([taskId, teacherId])
  @@index([taskId])
  @@index([teacherId])
}

model CharacterTaskProgress {
  id          String   @id @default(cuid())
  status      String   @default("PENDING") // PENDING, TAUGHT, COMPLETED
  notes       String?
  completedAt DateTime?
  taughtAt    DateTime?
  
  taskId      String
  task        CharacterTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  studentId   String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  teacherId   String?
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([taskId, studentId])
  @@index([taskId])
  @@index([studentId])
}

// ─────────────────────────────────────────────
