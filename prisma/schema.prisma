// ─────────────────────────────────────────────
// HOLIDAY MANAGEMENT
// ─────────────────────────────────────────────

enum HolidayType {
  WEEKLY
  PUBLIC
  SCHEDULED
}

model InstituteHoliday {
  id          String      @id @default(cuid())
  instituteId String
  institute   Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  type        HolidayType
  name        String
  dayOfWeek   Int?        // 0=Sunday … 6=Saturday (WEEKLY only)
  startDate   DateTime?   @db.Date
  endDate     DateTime?   @db.Date
  isActive    Boolean     @default(true)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([instituteId])
  @@index([instituteId, type])
}

// ─────────────────────────────────────────────
// CALENDAR & SPIRITUAL TRACKING
// ─────────────────────────────────────────────

enum EventType {
  HOLIDAY
  EXAM
  EVENT
  ACADEMIC
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  type        EventType
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([instituteId])
  @@index([startDate])
}

model DailyWorshipRecord {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  
  // Prayers (True if offered)
  fajr        Boolean  @default(false)
  dhuhr       Boolean  @default(false)
  asr         Boolean  @default(false)
  maghrib     Boolean  @default(false)
  isha        Boolean  @default(false)
  
  // Durood
  duroodCount Int      @default(0)
  
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  loggedById  String   // User ID who logged it (Student or Parent)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, date])
  @@index([studentId])
}
